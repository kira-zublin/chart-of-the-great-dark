# Supply credentials for the intended Turso database in your local .env file or Vercel environment.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Shared registration invite code. Keep this server-side.
REGISTRATION_INVITE_CODE=
# Vercel Blob read/write token for jukebox uploads (added by connecting a Blob store in Vercel). Server-side only.
BLOB_READ_WRITE_TOKEN=
